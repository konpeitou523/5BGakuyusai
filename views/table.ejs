<!doctype html>
<html lang="ja">
  <head>
    <link rel="icon" href="/images/icon.jpg" type="image/jpeg" />
    <link rel="stylesheet" href="/css/table.css" />
    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans"
      rel="stylesheet"
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>テストページ</title>
  </head>
  <body>
    <h1>5B学友祭予約ページ</h1>
    <div class="table">
      <table>
        <colgroup>
          <col class="tab">
          <col class="reservation">
          <col class="button">
          <col class="note">
        </colgroup>
        <tr>
          <td class="topcell">&nbsp;</td>
          <th class="topcell">予約状況</th>
          <th class="topcell">ボタン</th>
          <th class="topcell">備考</th>
        </tr>
        <% for(let i=540;i<=820;i=i+interval) { %>
          <% hour=String(Math.floor(i/60)).padStart(2,"0"); %>
          <% minute=String(i%60).padStart(2,"0"); %>
          <tr>
            <th><%= `${hour}:${minute}~` %></th>
            <td><%= `${schedule[`${hour}:${minute}`]}/${maxpeople}` %></td>
            <td><button>予約</button></td>
            <td></td>
        <% } %>
      </table>      
    </div>

<% reservations.forEach(reservation => { %>

    <p>
        <%= reservation.name %>
        /
        <%= reservation.time %>
        /
        <%= reservation.people %>人
    </p>

<% }) %>

    <script src="/scripts/main.js"></script>
    <script src="/scripts/table.js"></script>
  </body>
</html>
