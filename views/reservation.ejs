<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <title>予約送信フォーム</title>
  <link rel="icon" href="/images/icon.jpg" type="image/jpeg" />
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/reservation.css">
</head>

<body>
  <div id="mypageNotice"></div>
  <h1>予約送信ページ</h1>
  <form action="" method="post">
    <p>
      <label for="name">代表者氏名(必須):</label>
      <input type="text" name="name" id="name" required />
    </p>
    <p>
      <label for="time">開始時間を選んでください(必須):</label>
      <select name="time" id="time" required>
        <% for(let i=540;i <=820;i=i+interval) { %>
          <% const hour=String(Math.floor(i/60)).padStart(2,"0"); %>
          <% const minute=String(i%60).padStart(2,"0"); %>
          <option value="<%= hour + ':' + minute %>" <%= (hour + ':' + minute) === selectedtime ? "selected" : "" %>>
            <%= hour + ':' + minute %>~
          </option>
        <%}%>
        </select>
      </p>
      <p>
        <label for="people">参加者の総数(必須):</label>
        <select name="people" id="people" required>
          <% for(let i=1;i<=maxpeople;i++) { %>
          <option value=<%=i%>><%= `${i}人` %></option>
          <%}%>
        </select>
      </p>
      <input type="hidden" name="token" id="reservationToken" value="">
      <p><button type="submit">送信</button></p>
</form>
<script>
  const reservationToken=localStorage.getItem("reservationToken");
  if (reservationToken) {
  const p = document.createElement("p");
  p.textContent =
    "お客様はすでに登録されています。下のボタンからマイページへ移動できます。";

  const mypagebutton = document.createElement("button");
  mypagebutton.textContent = "マイページへ移動";

  mypagebutton.addEventListener("click", () => {
    location.href = `/mypage?token=${reservationToken}`;
  });

  const area = document.getElementById("mypageNotice");
  area.append(p);
  area.append(mypagebutton);

  document.getElementById("reservationToken").value = reservationToken;
  }
</script>
<script src="/scripts/main.js"></script>
<script src="/scripts/reservation.js"></script>
</body>
</html>